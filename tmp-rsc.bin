efdc2","order":1,"category":"transport","title":"상해 푸동 국제공항(PVG) 도착","description":"중국남방항공을 이용하여 상해 푸동 국제공항에 도착합니다. 입국 수속 후 시내로 이동합니다.","location":"Shanghai Pudong International Airport","startTime":"13:30","durationMinutes":90,"estimatedCostKrw":30000,"estimatedCostNote":"자기부상열차(Maglev) 및 택시 이용 기준","transportMode":"택시","transportDuration":"60분","transportCostKrw":null},{"id":"cmptjsuzm18f025e87c6d4e9e","order":2,"category":"hotel","title":"상하이 쑤닝 노보텔 호텔 체크인","description":"준 5성급의 쾌적한 객실에서 짐을 풀고 잠시 휴식을 취하며 여행을 준비합니다.","location":"Novotel Shanghai Suning","startTime":"15:30","durationMinutes":60,"estimatedCostKrw":0,"estimatedCostNote":"숙박비 포함","transportMode":null,"transportDuration":null,"transportCostKrw":null},{"id":"cmptjsv1o5373467708af0656","order":3,"category":"attraction","title":"와이탄(外滩) 야경 산책","description":"상하이의 랜드마크인 황포강변을 걸으며 유럽풍 건축물과 건너편 푸동의 고층 빌딩 숲이 만드는 환상적인 야경을 배경으로 커플 스냅 사진을 남깁니다.","location":"The Bund","startTime":"18:00","durationMinutes":120,"estimatedCostKrw":0,"estimatedCostNote":"자유 관람","transportMode":"택시","transportDuration":"30분","transportCostKrw":null},{"id":"cmptjsv3q0d765690815b6d28","order":4,"category":"meal","title":"라오라오(Grandmother's House) 저녁 식사","description":"와이탄 근처의 유명한 가정식 레스토랑에서 달콤한 '홍샤오러우'와 '마파두부'를 즐깁니다.","location":"Grandmother's House (Lao Lao)","startTime":"20:00","durationMinutes":90,"estimatedCostKrw":40000,"estimatedCostNote":"현지 통화 약 200 CNY 기준","transportMode":"도보","transportDuration":"10분","transportCostKrw":null}]},{"id":"cmptjsv5r13ae4d4ae877c0ed","dayNumber":2,"title":"과거와 현재가 만나는 로맨틱 데이트","summary":"트렌디한 신천지 거리와 역사적인 장소를 방문하고 황포강 유람선에서 야경의 정점을 찍습니다.","activities":[{"id":"cmptjsv7t177d6f9d7a596350","order":1,"category":"attraction","title":"신천지(新天地) & 대한민국 임시정부 청사","description":"유럽풍 노천 카페가 가득한 신천지를 산책하고, 인근의 역사적인 임시정부 청사를 방문하여 뜻깊은 시간을 보냅니다.","location":"Xintiandi","startTime":"10:00","durationMinutes":150,"estimatedCostKrw":4000,"estimatedCostNote":"임시정부 청사 입장료 약 20 CNY 기준","transportMode":"MRT","transportDuration":"25분","transportCostKrw":null},{"id":"cmptjsv9u134b512ad0990a77","order":2,"category":"meal","title":"신천지 브런치 데이트","description":"세련된 분위기의 테라스에서 파스타나 딤섬 등 취향에 맞는 브런치를 즐깁니다.","location":"Xintiandi Style","startTime":"12:30","durationMinutes":90,"estimatedCostKrw":50000,"estimatedCostNote":"현지 통화 약 260 CNY 기준","transportMode":null,"transportDuration":null,"transportCostKrw":null},{"id":"cmptjsvbwb3376bc945280b57","order":3,"category":"attraction","title":"동방명주(东方明珠) 전망대","description":"상하이의 상징인 동방명주에 올라 투명 유리 바닥 위에서 아찔하고 스릴 넘치는 도시 전경을 감상합니다.","location":"Oriental Pearl TV Tower","startTime":"15:00","durationMinutes":120,"estimatedCostKrw":45000,"estimatedCostNote":"전망대 입장권 약 220 CNY 기준","transportMode":"MRT","transportDuration":"20분","transportCostKrw":null},{"id":"cmptjsvdye24cbfeaa08d0288","order":4,"category":"attraction","title":"황포강 유람선 탑승","description":"강 위에서 양옆으로 펼쳐지는 화려한 조명 쇼를 관람하며 로맨틱한 상하이의 밤을 만끽합니다.","location":"Huangpu River Cruise","startTime":"19:30","durationMinutes":60,"estimatedCostKrw":30000,"estimatedCostNote":"유람선 티켓 약 150 CNY 기준","transportMode":"도보","transportDuration":"15분","transportCostKrw":null}]},{"id":"cmptjsvg1b518400ece59fa61","dayNumber":3,"title":"예술적 감성과 전통의 숨결 속으로","summary":"세계 최대 규모의 스타벅스와 예술가들의 거리, 그리고 고풍스러운 옛거리를 탐방합니다.","activities":[{"id":"cmptjsvi4dc033a06bee36aac","order":1,"category":"attraction","title":"스타벅스 리저브 로스터리 상하이","description":"축구장 절반 크기의 압도적인 규모를 자랑하는 이곳에서 특별한 원두 커피와 베이커리를 경험합니다.","location":"Starbucks Reserve Roastery Shanghai","startTime":"10:00","durationMinutes":90,"estimatedCostKrw":25000,"estimatedCostNote":"커피 및 디저트 비용 기준","transportMode":"MRT","transportDuration":"30분","transportCostKrw":null},{"id":"cmptjsvk508f183f57381a0c4","order":2,"category":"shopping","title":"타이캉로 티엔즈팡(田子坊)","description":"미로 같은 골목 속에 숨겨진 아기자기한 공방과 갤러리에서 독특한 기념품과 수공예품을 쇼핑합니다.","location":"Tianzifang","startTime":"12:30","durationMinutes":120,"estimatedCostKrw":30000,"estimatedCostNote":"쇼핑 및 간식 비용 기준","transportMode":"택시","transportDuration":"15분","transportCostKrw":null},{"id":"cmptjsvm796ed90f3385d35f2","order":3,"category":"attraction","title":"예원(豫园) & 상해 옛거리","description":"명나라 시대의 정원인 예원과 그 주변의 고풍스러운 상점가에서 전통적인 중국의 정취를 느끼며 산책합니다.","location":"Yu Garden & Old Street","startTime":"15:30","durationMinutes":120,"estimatedCostKrw":8000,"estimatedCostNote":"예원 입장료 약 40 CNY 기준","transportMode":"MRT","transportDuration":"20분","transportCostKrw":null},{"id":"cmptjsvo89d194dde84998784","order":4,"category":"meal","title":"남상만두(南翔馒头店) 저녁 식사","description":"예원의 명물인 빨대 꽂아 먹는 대형 소룡포(탕바오)와 다양한 딤섬으로 풍성한 저녁을 즐깁니다.","location":"Nanxiang Steamed Bun Restaurant","startTime":"18:00","durationMinutes":90,"estimatedCostKrw":35000,"estimatedCostNote":"현지 통화 약 180 CNY 기준","transportMode":"도보","transportDuration":"5분","transportCostKrw":null}]},{"id":"cmptjsvq9e0c8bb9f0b241e76","dayNumber":4,"title":"아쉬움을 뒤로하고 떠나는 마지막 산책","summary":"호텔 조식 후 난징동루에서 마지막 쇼핑을 즐기고 공항으로 이동합니다.","activities":[{"id":"cmptjsvsbcede3ee2ed9cb2b1","order":1,"category":"meal","title":"호텔 조식 및 체크아웃","description":"노보텔의 깔끔한 조식 뷔페로 아침을 시작하고 체크아웃을 준비합니다.","location":"Novotel Shanghai Suning","startTime":"08:30","durationMinutes":90,"estimatedCostKrw":0,"estimatedCostNote":"호텔 조식 포함","transportMode":null,"transportDuration":null,"transportCostKrw":null},{"id":"cmptjsvucc180e06f1ea68e74","order":2,"category":"shopping","title":"난징동루(南京东路) 쇼핑","description":"상하이 최대의 번화가에서 지인들을 위한 과자, 차(Tea) 등 마지막 기념품 쇼핑을 즐깁니다.","location":"Nanjing Road East","startTime":"10:30","durationMinutes":120,"estimatedCostKrw":50000,"estimatedCostNote":"개인 쇼핑 비용","transportMode":"MRT","transportDuration":"20분","transportCostKrw":null},{"id":"cmptjsvwe1493b7f1c997e627","order":3,"category":"transport","title":"상해 푸동 국제공항으로 이동","description":"비행기 시간에 맞춰 공항으로 이동하여 출국 수속을 진행합니다.","location":"Shanghai Pudong International Airport","startTime":"13:30","durationMinutes":120,"estimatedCostKrw":10000,"estimatedCostNote":"공항 이동 비용 기준","transportMode":"택시","transportDuration":"60분"