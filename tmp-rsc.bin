/bongtour/photo-pool/%EC%83%81%ED%95%B4_primary_cover_pexels__mprq35fo.webp","bgImagePhotographer":"zhang kaiyv","primaryDestination":"상해","schedule":[{"day":1,"description":"인천 국제공항을 출발하여 상해 푸동 국제공항에 도착합니다. 입국 수속을 마친 후 개별적으로 호텔로 이동하여 체크인을 진행합니다. 상해에서의 첫날을 편안하게 마무리하며 다음 날부터 시작될 자유 일정을 준비합니다.","title":"인천 출발 및 상해 도착","imageKeyword":"Shanghai","imageUrl":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Shanghai_pexels__mprq2c51.webp","imageUrl2":null,"imageDisplayName":"Shanghai","imageDisplayName2":null,"imagePhotographer":"zhang kaiyv","imageSource":"pexels","imagePhotographer2":null,"imageSource2":null,"hotelText":"상하이 쑤닝 노보텔 호텔","breakfastText":null,"lunchText":null,"dinnerText":null,"mealSummaryText":null,"meals":null,"city":"인천 - 상해"},{"day":2,"description":"호텔 조식 후 상해의 매력을 만끽할 수 있는 전일 자유 일정을 즐깁니다. 트렌디한 신천지 거리와 역사적인 임시정부청사를 방문하거나, 동방명주 전망대에서 도시 전경을 감상할 수 있습니다. 저녁에는 황포강 유람선을 타고 화려한 야경을 감상하며 낭만적인 시간을 보냅니다.","title":"상해 전일 자유 일정","imageKeyword":"Xintiandi","imageKeyword2":"Oriental Pearl Tower","imageUrl":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Xintiandi_pexels__mprq2fwp.webp","imageUrl2":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Oriental_Pearl_Tower_pexels__mprq2kaf.webp","imageDisplayName":"Xintiandi","imageDisplayName2":"Oriental Pearl Tower","imagePhotographer":"苔  上雪","imageSource":"pexels","imagePhotographer2":"zhang kaiyv","imageSource2":"pexels","hotelText":"상하이 쑤닝 노보텔 호텔","breakfastText":"호텔식","lunchText":"불포함","dinnerText":"불포함","mealSummaryText":"조식 - 호텔식, 중식 - 불포함, 석식 - 불포함","meals":"호텔식 / 불포함 / 불포함","city":"상해 - 신천지 - 임시정부청사 - 동방명주 - 황포강유람선"},{"day":3,"description":"상해의 전통과 현대가 어우러진 장위엔과 예술가들의 거리인 타이캉로를 탐방합니다. 세계 최대 규모의 스타벅스 리저브 로스터리에서 특별한 커피 문화를 체험하고, 상해 옛거리에서 고풍스러운 중국의 정취를 느껴봅니다. 다양한 쇼핑과 먹거리를 즐기며 상해의 다채로운 모습을 경험합니다.","title":"상해 도심 자유 관광","imageKeyword":"Starbucks Reserve Roastery","imageKeyword2":"Shanghai","imageUrl":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Starbucks_Reserve_Roastery_pexels__mprq2pzd.webp","imageUrl2":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Shanghai_pexels__mprq2wdf.webp","imageDisplayName":"Starbucks Reserve Roastery","imageDisplayName2":"Shanghai","imagePhotographer":"David Iglesias","imageSource":"pexels","imagePhotographer2":"隔壁光头老王 WangMing'Photo","imageSource2":"pexels","hotelText":"상하이 쑤닝 노보텔 호텔","breakfastText":"호텔식","lunchText":"불포함","dinnerText":"불포함","mealSummaryText":"조식 - 호텔식, 중식 - 불포함, 석식 - 불포함","meals":"호텔식 / 불포함 / 불포함","city":"상해 - 장위엔 - 타이캉로 - 스타벅스 리저브 로스터리 - 상해옛거리"},{"day":4,"description":"이른 아침 호텔 체크아웃을 마치고 상해 푸동 국제공항으로 이동합니다. 귀국 항공편에 탑승하여 인천 국제공항으로 향합니다. 짧지만 알찼던 3박 4일간의 상해 자유여행 일정을 모두 마무리합니다.","title":"상해 출발 및 인천 도착","imageKeyword":"Shanghai","imageUrl":"https://kr.object.ncloudstorage.com/bongtour/photo-pool/%EC%83%81%ED%95%B4_Shanghai_pexels__mprq2zhx.webp","imageUrl2":null,"imageDisplayName":"Shanghai","imageDisplayName2":null,"imagePhotographer":"Pixabay","imageSource":"pexels","imagePhotographer2":null,"imageSource2":null,"hotelText":null,"breakfastText":"불포함","lunchText":null,"dinnerText":null,"mealSummaryText":"조식 - 불포함","meals":"불포함","city":"상해 - 인천"}],"bgImageSource":"pexels","bgImageIsGenerated":false,"bgImagePlaceName":"인천 - 상해","bgImageRehostSearchLabel":"Shanghai","heroImageSeoKeywordOverlay":"상해 · 준5성급 · 자유여행","flightStructured":{"airlineName":"중국남방항공","departureSegmentText":"가는편: 인천 2026.06.04 21:30 → 상해-푸동 2026.06.04 22:45 / CZ370","returnSegmentText":"오는편: 상해-푸동 2026.06.07 08:30 → 인천 2026.06.07 11:35 / CZ313","routeRaw":null,"flightRaw":"$29","detailBodyNormalizedRaw":"$2a","outboundFlightNo":"CZ370","inboundFlightNo":"CZ313","departureDateTimeRaw":null,"arrivalDateTimeRaw":null,"useModetourStructuredFlightLegs":true,"modetourPersistedFlightStructured":{"airlineName":"중국남방항공","outbound":{"departureAirport":"인천","departureAirportCode":null,"departureDate":"2026-06-04","departureTime":"21:30",