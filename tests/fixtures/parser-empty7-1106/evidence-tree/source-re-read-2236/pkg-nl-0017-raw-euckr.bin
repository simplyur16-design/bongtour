		function fnTab(i,page){
			var sub_area_cd = $("#sub_area_cd").val();
			var area = $("#area").val();
			var good_cd = $("#good_cd").val();
			var sel_day = $("#sel_day").val();
			var event_ev_ym = $("#event_ev_ym").val();
			var event_seq = $("#event_seq").val();
			var sub_cd = $("#sub_cd").val();
			var ev_ym = $("#ev_ym").val();
			var ev_seq = $("#ev_seq").val();
			var nat_cd = $("#nat_cd").val();
			var air_sect_seq = $("#air_sect_seq").val();
			var cate = $("#cate").val();
			var a_code = $("#a_code").val();
			var gotp = $("#gotp").val();
			var detail = $("#detail").val();
			var area_cd = $("#area_cd").val();
			var chk_air_cd = $("#chk_air_cd").val();
			var schd_seq = $("#schd_seq").val();
			var rep_schd_seq = $("#rep_schd_seq").val();

			if(i==0){
				var params = "mode=view_tab_"+ i +"&number=1&sub_area_cd="+ sub_area_cd +"&area="+ area +"&good_cd="+ good_cd +"&sel_day="+ sel_day +"&event_ev_ym="+ event_ev_ym +"&rep_schd_seq="+ rep_schd_seq +"&schd_seq="+ schd_seq +"&event_seq="+ event_seq +"&chk_no=Y&sub_cd="+ sub_cd +"&ev_ym="+ ev_ym +"&ev_seq="+ ev_seq +"&nat_cd="+ nat_cd +"&area_cd="+ area_cd;
				
			}else if(i==1){
				//추천일정
				var params = "mode=view_tab_"+ i +"&sub_area_cd="+ sub_area_cd +"&nat_cd="+ nat_cd +"&air_sect_seq="+ air_sect_seq +"&cate="+ cate;
					params += "&a_code="+ a_code +"&gotp="+ gotp +"&detail"+ detail;
					params += "&area="+ area +"&good_cd="+ good_cd +"&sel_day="+ sel_day +"&event_ev_ym="+ event_ev_ym+"&schd_seq="+ schd_seq +"&rep_schd_seq="+ rep_schd_seq;
					params += "&event_seq="+ event_seq +"&chk_no=Y&sub_cd="+ sub_cd +"&strUrl1=&area_cd="+ area_cd +"&chk_air_cd="+ chk_air_cd;
					
			}else if(i==2){
				//호텔
				var params = "mode=view_tab_"+ i +"&nat_cd="+ nat_cd +"&air_sect_seq="+ air_sect_seq +"&cate="+ cate;
					params += "&a_code="+ a_code +"&gotp="+ gotp +"&detail"+ detail;
					params += "&area="+ area +"&good_cd="+ good_cd +"&sel_day="+ sel_day +"&event_ev_ym="+ event_ev_ym +"&schd_seq="+ schd_seq +"&rep_schd_seq="+ rep_schd_seq;
					params += "&event_seq="+ event_seq +"&chk_no=Y&sub_cd="+ sub_cd +"&strUrl1=&area_cd="+ area_cd +"&chk_air_cd="+ chk_air_cd;
					
			}else if(i==3){
				//도시
				var params = "mode=view_tab_"+ i +"&nat_cd="+ nat_cd +"&air_sect_seq="+ air_sect_seq +"&cate="+ cate;
					params += "&a_code="+ a_code +"&gotp="+ gotp +"&detail"+ detail;
					params += "&area="+ area +"&good_cd="+ good_cd +"&sel_day="+ sel_day +"&event_ev_ym="+ event_ev_ym+"&schd_seq="+ schd_seq +"&rep_schd_seq="+ rep_schd_seq;
					params += "&event_seq="+ event_seq +"&chk_no=Y&sub_cd="+ sub_cd +"&strUrl1=&area_cd="+ area_cd +"&chk_air_cd="+ chk_air_cd;
					
			}else if(i==4){
				//여행후기
				if(page==""){ page="1"; }
				var params = "mode=view_tab_"+ i +"&nat_cd="+ nat_cd +"&air_sect_seq="+ air_sect_seq +"&cate="+ cate;
					params += "&a_code="+ a_code +"&gotp="+ gotp +"&detail"+ detail;
					params += "&area="+ area +"&good_cd="+ good_cd +"&sel_day="+ sel_day +"&event_ev_ym="+ event_ev_ym;
					params += "&event_seq="+ event_seq +"&chk_no=Y&sub_cd="+ sub_cd +"&strUrl1=&area_cd="+ area_cd +"&chk_air_cd="+ chk_air_cd +"&page="+ page;
			}else if(i==5){
				//묻고답하기
				if(page==""){ page="1"; }
				var params = "mode=view_tab_"+ i +"&good_cd="+ good_cd +"&page="+ page;

				$(".if-taps li").removeClass("active")
				$(".if-taps li").eq(i).addClass("active")

				$(".tabs-infos div").removeClass("show")
				$("#tab_qna").addClass("show")
			}

			if(i==0){
				$(".tab_info").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}else if(i==1){
				$(".tab_schedule").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}else if(i==2){
				$(".tab_hotel").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}else if(i==3){
				$(".tab_city").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}else if(i==4){
				$(".tab_goodReview").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}else if(i==5){
				$(".tab_qna").html("<p class='dsc_loading'><div style='width:100%;text-align:center;padding:5px 0 5px 0;'></div><div style='width:100%;text-align:center;padding-bottom:20px;'><img width='150' height='13' alt='로딩중' src='/mweb/images/loadbar.gif' /></div></p>");
			}
			
			$.ajax({
				type: "GET",
				url: "view_process.asp",
				data: params,
				success: function(res){
					if(i==0){
						$(".tab_info").html(res);
					}else if(i==1){
						$(".tab_schedule").html(res);
					}else if(i==2){
						$(".tab_hotel").html(res);
					}else if(i==3){
						$(".tab_city").html(res);
					}else if(i==4){
						$(".tab_goodReview").html(res);
						refreshFsLightbox();
						viewToggle()
					}else if(i==5){
						$(".tab_qna").html(res);
					}
					/*
					$("#res_coupon_layer").css("display","block");
					$("#Wrap").css({"width":"100%","height":"100%","overflow-y":"hidden","position":"relative"});
					$("#header").on('touchmove', function(e){e.preventDefault()});
					*/
				}
			});
			return false;
		}

		function viewToggle(){
			$('.f_wrap').on('click', function () {
				var index = $(this).data('index');
				// 클릭한 인덱스에 해당하는 q_wrap 열기
				$('#q_wrap' + index).slideToggle();
			});
		}

		function wrapImagesInGallery(container) {
			const galleryName = `gallery-${container.id}`; //const galleryName = container.id; // id 값으로 갤러리 이름 설정
			//console.log("galleryName:"+ galleryName);

			container.querySelectorAll('img').forEach(el => {
				// 중복 방지: 이미 a 태그로 감싸져 있으면 skip
				if (el.parentElement.tagName.toLowerCase() === 'a') return;

				const anchor = document.createElement('a');
				anchor.href = el.src;
				anchor.setAttribute('data-fslightbox', galleryName); // 고유 갤러리 이름
				el.parentElement.insertBefore(anchor, el);
				anchor.appendChild(el);
			});
		}

		function getPop(){
			$.ajax({
				type: "GET",
				url:  "backpack_popup.asp",
				data: "",
				success: function(res){
					temp_res = res.split("////");
					document.getElementById("layer_pop_wrap").innerHTML = temp_res[0];
					document.getElementById("layer_pop_wrap").style.display = "block";
					content.trigger("create");
				},
				async: true
			});
		}

		function doScrap(query){
			$.ajax({
				type: "GET",
				url:  "pop_attention.asp",
				data: "cate=&attention_good=&"+ query,
				success: function(res){
					if(res=="re"){
						//alert("이미 관심상품에 추가되었습니다.");
						$(".reser .favo-btn").removeClass("active");
					}else{
						alert("관심상품에 추가 되었습니다.\n\n마이페이지에서 확인 가능합니다.");
						$(".reser .favo-btn").addClass("active");
					}
				},
				async: true
			});
		}

		function fnView(query){
		}
