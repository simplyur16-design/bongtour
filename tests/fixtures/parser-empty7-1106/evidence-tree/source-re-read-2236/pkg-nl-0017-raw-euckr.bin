<div id="iframeLayer" class="layer hidden">
	<!-- <button class="close-btn2" onclick="closeLayer()">X</button> -->
	<div class="layer-content">
		<iframe title="콘텐츠" id="layerIframe" scrolling="yes" style="overflow:hidden"></iframe>
	</div>
</div>

<script>
	function openLayerWithURL(url) {
		const iframe = document.getElementById('layerIframe');
		iframe.src = url;
		document.getElementById('iframeLayer').classList.remove('hidden');
		//document.body.classList.add('no-scr');
	}

    function closeLayer() {
		const iframe = document.getElementById('layerIframe');
		document.getElementById('iframeLayer').classList.add('hidden');
		iframe.src = ''; // 불필요한 네트워크 요청 방지
		//document.body.classList.remove('no-scr');
	}

	// iframe으로부터 메시지 수신 대기
	window.addEventListener('message', (event) => {
		
		const expectedOrigin = window.location.origin; // 현재 부모 페이지의 출처를 가져옴
		/*
		if (event.origin !== expectedOrigin) {
			console.warn('보안 경고: 알 수 없는 출처에서 메시지 수신:', event.origin);
			return; // 우리가 예상하는 출처가 아니면 처리하지 않음
		}
		*/

		if (event.data === 'closeIframeLayer') {
			closeLayer();
		}
	});
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/fslightbox/3.4.1/index.min.js"></script>
<style>
	.fslightbox-toolbar-button:first-child {
	  display: none !important;
	}

	.fslightbox-source {
		max-width: 60vw; /* 화면 너비의 최대 90% */
		max-height: 60vh; /* 화면 높이의 최대 90% */
		width: auto;
		height: auto;
		object-fit: contain; /* 비율 유지하면서 잘림 없이 표시 */
		margin: auto;
		display: block;
	}

	.fslightbox-container {
	  top: 50%;
	  left: 50%;
	  transform: translate(-50%, -50%);
	  width: 50%;      /* 원하는 가로 크기 */
	  height: 70%;     /* 원하는 세로 크기 */
	  max-width: 90vw;
	  max-height: 90vh;
	  background-color: rgba(0, 0, 0, 0.9);
	  border-radius: 8px;
	  overflow: hidden;
	}


	.fslightbox-slide, .fslightbox-source {
	  width: 90% !important;
	  height: 90% !important;
	  max-width: 90vw !important;;
	  max-height: 70vh !important;
	  object-fit: contain;
	}



	.layer {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/*background: rgba(0, 0, 0, 0.6);*/
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 9999;
    }

    .layer-content {
		position: relative;
		background: white;
		width: 50%;
		height: 70%;
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
		animation: fadeIn 0.3s ease;
    }

    .layer-content iframe {
		width: 100%;
		height: 100%;
		border: none;
    }

    .close-btn2 {
		position: absolute;
		top: 22px;
		right: 35px;
		font-size: 20px;
		background-color: #FFFFFF;
		border: none;
		cursor: pointer;
		z-index: 101;
    }

    .hidden {
		display: none;
    }

    @keyframes fadeIn {
		from { opacity: 0; transform: scale(0.95); }
		to { opacity: 1; transform: scale(1); }
    }
</style>

