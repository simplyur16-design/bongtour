m":null,"cardMainCd":null,"cardNm":null,"bndlCardYn":null,"chcStsngCd":null,"cardCntntTitlNm":null,"schdDay":2,"airCityExprYn":"Y","cmsCardDvCd":null,"cardCntnt":null,"cardCntntPc":null,"cardCntntMbl":null,"trfcMensCd":null,"trfcMensNm":null,"spclStsngYn":"N","frdmSchdDtlCd":null,"frdmSchdDtlNm":null,"frdmSchdDtlCont1":null,"frdmSchdDtlCont2":null,"cmsInfoList":null,"meetingPlaceKindCode":null,"representativePlaceYn":null,"gpsLatitude":null,"gpsLongitude":null,"address":null,"detailAddress":null},{"schtExprSqc":4,"schdCatgCd":"005","schdCatgNm":"선택관광","schdRqrmTm":"0","schdRqrmHm":"0","memoTitlNm":null,"memoCont":null,"extriStsngYn":"N","vhcwndStsngYn":"N","cmsCardId":"20260716000013","dtlMealDvNm":null,"mealTypeNm":null,"mealTypeCd":null,"mealCont":null,"depCityCd":null,"depCityNm":null,"arrCityCd":null,"arriveCityNm":null,"cardMainCd":null,"cardNm":"아시아 최대규모의 '빈펄 사파리'","bndlCardYn":null,"chcStsngCd":null,"cardCntntTitlNm":"빈펄 사파리","schdDay":2,"airCityExprYn":"Y","cmsCardDvCd":"G","cardCntnt":null,"cardCntntPc":"<div class='card_mngr'><div class='card_unit type_set'><div class='tit_box bg'><div class='_tit title'><strong class='eps'>아시아 최대규모의 '빈펄 사파리'</strong></div></div><div class=\"card_mngr\">\n    <div class=\"card_unit type14\">\n        <div class=\"_tit title\"><strong class=\"eps\"><span class=\"tag_group\"><span class='grade type2'>스페셜포함</span><span class='grade type6'>MD추천</span></span>빈펄 사파리</strong></div>\n        <div class=\"_tit_comt sub\"></div>\n        <div class=\"_info_section cont_box\">\n            <div class=\"_thumb thumb\"><div class=\"img_list\"><img src=\"https://image.hanatour.com/usr/cms/resize/400_0/2019/01/03/10000/053d19c9-3a55-4113-9261-1975a3432ccc.jpg\" alt=\"사파리\"><img src=\"https://image.hanatour.com/usr/cms/resize/400_0/2019/01/03/10000/5f7454b5-6ff3-4c27-84c8-bc47ca8e8ffd.jpg\" alt=\"사파리\"><img src=\"https://image.hanatour.com/usr/cms/resize/400_0/2019/01/03/10000/731500f9-0342-4537-ac3e-339f6671effe.jpg\" alt=\"사파리\"></div></div>\n            <div class=\"_txt_cont txt_conts\"><div><p>&nbsp;아시아 최대 규모를 자랑하는 푸꾸옥 빈펄 사파리는 400여 종의 식물과 150종의 동물이 있어 마치 작은 아프리카에 온 듯한 기분을 느낄 수 있습니다. 각종 동물 쇼와 새 공원 등 다채로운 볼거리 가득한 빈펄 사파리를 즐겨보세요. (최소출발인원: 4명)</p><p><br></p><p><b>포함사항</b> : 빈펄 사파리 입장권 (1인 1매), 왕복 차량&nbsp;</p><p><br></p><p><b>참고사항</b></p><p>- 빈펄 사파리 관람 시간은 평균적으로 3시간 내외입니다. </p><p>- 사파리 내 투어버스는 무료 탑승 가능하며, 버기카 투어 시에 추가 비용 발생됩니다. (현장 결제)</p><p>\n</p></div></div>\n            <div class=\"_local_info txt_box disc\"></div>\n            \n            <div class=\"custom_tag_a\"><div class=\"txt_cont\"></div><div class=\"txt_cont\"><!--20230914000019_optCost--></div><div class=\"txt_cont\"><!--20230914000019_optTime--></div><div class=\"txt_cont\"><!--20230914000019_optReplace--></div><div class=\"txt_cont\"><!--20230914000019_PrgsImpbDowInfo--></div><div class=\"txt_cont\"><!--20230914000019_ntytChcGuidTcYn--></div><div class=\"txt_cont\"><!--20230914000019_prgsPsblNop--></div></div>\n        </div>\n        <hr class=\"line_white\">\n        <div class=\"custom_tag_b\"><div class=\"card_notice\"><div class=\"\"><!--20230914000019_custTitle--></div><div class=\"notice_cont\"><!--20230914000019_custMemo--></div></div></div>\n    </div>\n</div></div><div class='caution_section'><div class='caution'><p class='tit2'><!--custTitleGroup--></p><p class='cont'><!--custMemoGroup--></p></div><div class='lead_time'><p class='tit2'><!--timeTitleGroup--></p><p class='cont'></p></div></div></div>","cardCntntMbl":"<div class='card_mngr'><strong class='_tit tit'>아시아 최대규모의 '빈펄 사파리'</strong><div class='card_unit'><div class=\"card_mngr type14\">\n    <div class=\"card_unit\">\n        <div class=\"_tit tit\"><div class=\"tag_group\"><span class='state type3'>스페셜포함</span><span class='state type9'>MD추천</span></div><strong>빈펄 사파리</strong></div>\n        <div class=\"_tit_comt sub\"></div>\n        <div class=\"_thumb thumb img3\"><div class=\"scroll_box\">\n<span class=\"img_box\"><img src=\"https://image.hanatour.com/usr/cms