{
  "expo": {
    "name": "simplyur",
    "slug": "simplyur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simplyur",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bongtour.simplyur",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.bongtour.simplyur",
      "adaptiveIcon": {
        "backgroundColor": "#F5E8EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF4EF"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "brand": "simplyur",
      "audience": "foreign-visitors-korea-esim",
      "parentLegal": "Bong Tour Co., Ltd.",
      "privacyPolicyUrl": "https://bongtour.com/simplyur/en/legal/privacy",
      "termsUrl": "https://bongtour.com/simplyur/en/legal/terms",
      "supportUrl": "https://bongtour.com/simplyur/en",
      "supportEmail": "bongtour24@naver.com",
      "eas": {
        "projectId": "13ff775c-bb1f-4c06-bf1a-2fbf4ab014e5"
      },
      "router": {}
    },
    "owner": "bongtour"
  }
}
