{
  "expo": {
    "name": "simplyur",
    "slug": "simplyur",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "simplyur",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13ff775c-bb1f-4c06-bf1a-2fbf4ab014e5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bongtour.simplyur",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:bongtour.com",
        "applinks:www.bongtour.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": ["remote-notification"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "android": {
      "package": "com.bongtour.simplyur",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5E8EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bongtour.com",
              "pathPrefix": "/simplyur"
            },
            {
              "scheme": "https",
              "host": "www.bongtour.com",
              "pathPrefix": "/simplyur"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF4EF"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-document-picker",
      "expo-apple-authentication",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "brand": "simplyur",
      "audience": "foreign-visitors-korea-esim",
      "parentLegal": "Bong Tour Co., Ltd.",
      "privacyPolicyUrl": "https://bongtour.com/simplyur/en/legal/privacy",
      "termsUrl": "https://bongtour.com/simplyur/en/legal/terms",
      "supportUrl": "https://bongtour.com/simplyur/en",
      "supportEmail": "bongtour24@naver.com",
      "eas": {
        "projectId": "13ff775c-bb1f-4c06-bf1a-2fbf4ab014e5"
      },
      "router": {}
    },
    "owner": "bongtour"
  }
}
