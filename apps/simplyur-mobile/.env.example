# simplyur mobile — copy to .env for local prebuild (never commit secrets)
EXPO_PUBLIC_API_BASE_URL=https://bongtour.com
EXPO_PUBLIC_SIMPLYUR_CHECKOUT_ENABLED=1

# Google Sign-In (same Web client ID as server AUTH_GOOGLE_ID audience)
# Set these as EAS Secrets for preview/production builds:
#   npx eas-cli secret:create --scope project --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value "....apps.googleusercontent.com"
#   npx eas-cli secret:create --scope project --name EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID --value "....apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional — Sentry (EAS secret EXPO_PUBLIC_SENTRY_DSN). Empty = telemetry no-op.
EXPO_PUBLIC_SENTRY_DSN=

# Optional override; defaults to app.json extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=13ff775c-bb1f-4c06-bf1a-2fbf4ab014e5

# Prevent Expo CLI rewriting tsconfig.json (breaks monorepo Railway freeze)
EXPO_NO_TYPESCRIPT_SETUP=1
