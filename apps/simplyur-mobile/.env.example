# Production (store / release builds — also set in eas.json production.env)
EXPO_PUBLIC_API_BASE_URL=https://bongtour.com
EXPO_PUBLIC_SIMPLYUR_CHECKOUT_ENABLED=1

# Local API (uncomment one)
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Android emulator → http://10.0.2.2:3000
# Physical device (same Wi‑Fi) → http://192.168.x.x:3000

# Disable buy CTA while testing catalog only:
# EXPO_PUBLIC_SIMPLYUR_CHECKOUT_ENABLED=0
