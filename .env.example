# -----------------------------------------------------------------------------
# Usimsa Partner API v2 (봉심 eSIM — 서버 전용)
# -----------------------------------------------------------------------------
# 봉투어 운영 단계 기본값은 production. 개발자 로컬에서 USIMSA dev API만 쓸 때에만 development로 변경.
# 환경 분기: development → dev 호스트·USIMSA_DEV_ACCESS_KEY, production → prod·USIMSA_PROD_ACCESS_KEY
# 4차-E: USIMSA accesskey는 환경 무관 동일, secret만 환경별 분리. 메모리 #22 참조.
USIMSA_ENV=production
# 선택: 비우면 USIMSA_ENV 에 따라 자동(dev: open-api-dev…, prod: open-api…)
USIMSA_BASE_URL=
# (legacy) 단일 시크릿. 환경별 분리 시 USIMSA_DEV_SECRET_KEY / USIMSA_PROD_SECRET_KEY 사용. 값이 있으면 우선됨.
USIMSA_SECRET_KEY=
USIMSA_DEV_SECRET_KEY=
USIMSA_PROD_SECRET_KEY=
USIMSA_DEV_ACCESS_KEY=
USIMSA_PROD_ACCESS_KEY=
# 레거시: 단일 키만 쓰던 배포 호환. 값이 있으면 DEV/PROD 분리 키보다 우선한다.
USIMSA_ACCESS_KEY=
USIMSA_WEBHOOK_SECRET=
USIMSA_WEBHOOK_URL=
# 선택: USIMSA Partner API fetch 타임아웃(ms). 비우면 15000.
USIMSA_FETCH_TIMEOUT_MS=

# === simplyur (봉투어 하위 글로벌 브랜드) ===
# 판매가 = price_block.after.consumer_krw × 1.05 → locale 화폐로 표시 (FX 12h cache)
# KRW per 1 unit (비우면 lib/simplyur/currency.ts 기본값)
# SIMPLYUR_FX_USD=1350
# SIMPLYUR_FX_JPY=9.2
# SIMPLYUR_FX_CNY=185
# SIMPLYUR_FX_TWD=42
# SIMPLYUR_FX_VND=0.055
# Live FX (ExchangeRate-API) — 12h server cache; falls back to SIMPLYUR_FX_* / defaults
# SIMPLYUR_EXCHANGE_RATE_API_KEY=
# EXCHANGE_RATE_API_KEY=          # alias if SIMPLYUR_EXCHANGE_RATE_API_KEY unset
# Phase 2 checkout (PortOne — foreign visitors, separate from Welcomepay/bongsim)
# SIMPLYUR_CHECKOUT_ENABLED=1
# NEXT_PUBLIC_SIMPLYUR_CHECKOUT_ENABLED=1
# PORTONE_STORE_ID=          # PortOne console → store ID (store- prefix)
# PORTONE_API_SECRET=        # REST API secret (server only)
# PayPal SPB test channel — https://help.portone.io/content/paypal
#   Console: 테스트 연동 + 페이팔 + 결제창 일반결제(SPB)/정기결제(RT)
#   PG상점아이디: PortOne shared test Merchant ID (NOT PayPal Developer Client ID / NVP-SOAP)
#     UK (recommended): PA4DULN9V66L6
#     US: 7WBB3CKT63FRG | KR: UFYSG9T7RFW2A | JP: PX5CTVZJTRXG4 (full table: help.portone.io/content/paypal)
# PORTONE_CHANNEL_KEY_PAYPAL=  # channel key from THAT SPB channel after save
# PORTONE_CHANNEL_KEY_KICC=    # KICC — https://help.portone.io/content/kicc
#   Console: 테스트 연동 + 이지페이(KICC) + 일반결제 V1 (구모듈 결제창 일반/정기결제)
#   PG상점아이디(MID): 이지페이_KICC 결제창 일반결제 및 정기결제(T5102001) 선택 — 암복호화 키 불필요
# PORTONE_CHANNEL_KEY=         # legacy fallback → PayPal channel if PAYPAL unset
# PORTONE_ENV=test             # test | production
# PORTONE_TEST_CHANNEL=1       # use test channel in non-production
# PORTONE_WEBHOOK_SECRET=      # 콘솔 → 결제알림(Webhook) V2 → 웹훅 시크릿 (테스트/실연동 각각)
# PORTONE_WEBHOOK_SECRET_FORMAT=raw  # 서명 검증 실패 시: 콘솔에서 복사한 값 그대로면 raw
# Verify: npx tsx scripts/inspect-portone-channels-safe.ts
#         npx tsx scripts/verify-simplyur-portone-payment-window.ts --base-url=http://localhost:3000
# Webhook (PortOne console → Payment notifications V2):
#   https://YOUR_DOMAIN/api/simplyur/webhooks/portone
# KICC: register checkout domain with KICC for mobile WeChat Pay.
#
# Phase 2b — Eximbay payment window (Simplyur foreigners only)
# Docs: https://developer.eximbay.com/eximbay/payment_linkage/preparing-payment.html
# DO NOT put API key in NEXT_PUBLIC_* / browser bundles.
# Unset MID/KEY → 코드가 문서 공개 테스트 키(1849705C64 / test_1849705C642C217E0B2D)로 폴백.
# EXIMBAY_MID=                  # merchant mid (test doc sample: 1849705C64)
# EXIMBAY_API_KEY=              # server only; test keys start with test_, live with live_
# EXIMBAY_ENV=test              # test | production  → api-test.eximbay.com | api.eximbay.com
# Production Railway: EXIMBAY_ENV=production + live MID/key required (test_ keys rejected).
# SIMPLYUR_EXIMBAY_PREP_UI=1    # optional: show FGKey smoke panel on checkout (non-prod smoke ready)
# NEXT_PUBLIC_SIMPLYUR_EXIMBAY_PREP_UI=1
# status_url:  https://YOUR_DOMAIN/api/simplyur/webhooks/eximbay
# return_url:  https://YOUR_DOMAIN/simplyur/{locale}/checkout/eximbay-return
# Contract: docs/ops/simplyur-eximbay-payment-prep-contract.md
# Bongtour Welcomepay (WELCOMEPAY_*) is unrelated — never use for Simplyur.

BONGSIM_INTERNAL_IMPORT_SECRET=
BONGSIM_INTERNAL_FULFILLMENT_SECRET=
BONGSIM_MOCK_WEBHOOK_SECRET=
BONGSIM_ORDER_READ_KEY=
BONGSIM_SUPPLIER_CLIENT_ID=usimsa
BONGSIM_CHECKOUT_TEST_MODE=
NEXT_PUBLIC_BONGSIM_CHECKOUT_TEST_MODE=

# 웰컴페이먼츠(PayWelcome) — 봉심 eSIM 카드결제 (`provider: welcomepay`). 실제 키는 `.env.local` 등에만 저장.
# PayWelcome 빌링 테스트 MID 예: `wpaybill01`. signKey는 가맹 대시보드 발급값(구 예시 `welcometst` 등은 사용하지 않음).
WELCOMEPAY_MID=
WELCOMEPAY_SIGN_KEY=
# 모바일 welpay P_CHKFAKE HashKey — 가맹 부가정보 값이 있으면 여기에. 비우면 SHA256(signKey) hex(mkey) 사용.
WELCOMEPAY_MOBILE_HASH_KEY=
# raw 웹 Signkey로 P_CHKFAKE를 만들어야 하는 상점만 signkey (기본 mkey)
# WELCOMEPAY_MOBILE_HASH_KEY_SOURCE=signkey
# 필드암호화 IV (계좌 환불·빌링 등 PAYAPI 필드 AES 시). 카드 전액취소(§3.2.1)에는 미사용.
WELCOMEPAY_FIELD_ENCRYPT_IV=
# 운영 실결제: production (미설정 시 test → tmobile.paywelcome.co.kr 로 나감)
WELCOMEPAY_ENV=test
# 결제 UI 노출 수단 allowlist (쉼표). 미설정 시 card 만. vbank·bank 등은 코드에서 checkout 미노출.
# WELCOMEPAY_CHECKOUT_METHODS=card
# 간편결제(카카오·네이버·토스·PAYCO) — 가맹 승인 후. 운영(NODE_ENV=production) 기본 on, 끄려면 0
# WELCOMEPAY_EASY_PAY=1
# WELCOMEPAY_EASY_PAY_METHODS=kakaopay,naverpay,tosspay,payco
# PG returnUrl·P_NEXT_URL SSOT — 운영: https://bongtour.com (NEXTAUTH_URL만 두면 콜백이 잘못된 호스트로 갈 수 있음). 체크리스트: docs/ops/welcomepay-merchant-manual-checklist.md
# NEXT_PUBLIC_SITE_URL="https://bongtour.com"

# === USIMSA 웹훅 IP 화이트리스트 ===
USIMSA_WEBHOOK_ALLOWED_IPS=

# === PostgreSQL SSL ===
BONGSIM_PG_SSL_STRICT=

# -----------------------------------------------------------------------------
# 교원이지 (kyowontour) — 캘린더 HTTP / Selenium E2E / 등록 LLM (선택)
# -----------------------------------------------------------------------------
# 스크립트별 venv: scripts/calendar_e2e_scraper_kyowontour/requirements.txt
KYOWONTOUR_API_BASE_URL=https://www.kyowontour.com
KYOWONTOUR_PYTHON=python
KYOWONTOUR_E2E_TIMEOUT_MS=120000
# HTTP 0건일 때 Python E2E 1회 시도(0/false/off 로 끔)
# KYOWONTOUR_E2E_FALLBACK=1
KYOWONTOUR_CALENDAR_MONTH_COUNT=12
KYOWONTOUR_CALENDAR_TIMEOUT_MS=30000
KYOWONTOUR_CALENDAR_RETRY=3
KYOWONTOUR_REGISTER_MAX_OUTPUT_TOKENS=16384
KYOWONTOUR_SCHEDULE_EXTRACT_MAX_OUTPUT_TOKENS=12288
# KYOWONTOUR_REGISTER_BODY_MAX_CHARS=32000
# KYOWONTOUR_CALENDAR_USER_AGENT=
# KYOWONTOUR_DATE_FROM=
# KYOWONTOUR_DATE_TO=
# KYOWONTOUR_E2E_MAX_CLICKS=32
# KYOWONTOUR_E2E_MONTH_LIMIT=12
# KYOWONTOUR_E2E_HEADLESS=true
# KYOWONTOUR_E2E_TIMEOUT_S=60
# KYOWONTOUR_E2E_PAGE_LOAD_TIMEOUT_S=30
# KYOWONTOUR_E2E_AJAX_WAIT_S=10
# KYOWONTOUR_E2E_DETAIL_URL=
# KYOWONTOUR_USER_AGENT=

# -----------------------------------------------------------------------------
# 롯데관광 (lottetour) — 상세·캘린더 HTML / 등록 LLM (R-4 단계별 연동, 선택)
# -----------------------------------------------------------------------------
LOTTETOUR_BASE_URL=https://www.lottetour.com
# 출발일 목록: /evtlist/evtListAjax (공개 GET, HTML 테이블; godId·menuNo1~4·depDt=YYYYMM)
LOTTETOUR_PYTHON=python
# Python subprocess 한도(ms). TS collect 폴백·calendar_price_scheduler 공통.
LOTTETOUR_E2E_TIMEOUT_MS=600000
# TS fetch/HTML이 0건이고 evtCd 힌트가 있을 때 Python(requests) 폴백 1회 (0/false/off 끔)
LOTTETOUR_E2E_FALLBACK=1
# LOTTETOUR_REPO_ROOT=   # PYTHONPATH용 리포 루트(미설정 시 상위 디렉터리 탐색)
LOTTETOUR_CALENDAR_MONTH_COUNT=12
# LOTTETOUR_USER_AGENT=
# LOTTETOUR_DATE_FROM=
# LOTTETOUR_DATE_TO=
# LOTTETOUR_E2E_HEADLESS=true
# 관리자 parse-and-register-lottetour 오케스트레이션 — 로컬에서만 의미 있음(NODE_ENV=development).
# 다른 공급사 일부는 DEV_REGISTER_PERF_LOG 를 사용하나, 롯데관광 전용 키는 아래를 씁니다.
# LOTTETOUR_REGISTER_TIMING_LOG=1
# LOTTETOUR_REGISTER_PERF_LOG=1

